# Server-side only. Copy OUTSIDE the static website root, not into assets/.
# These are placeholders, not usable credentials.
ALBUM_PUBLIC_ORIGIN=https://album.example.com
ALBUM_BASE_PATH=/album/
ALBUM_USERNAME=change-me
ALBUM_PASSWORD=
ALBUM_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALBUM_OSS_BUCKET=your-private-bucket
ALBUM_ACCESS_KEY_ID=
ALBUM_ACCESS_KEY_SECRET=
ALBUM_CHAT_PREFIX=chatData/releases/your-version/

# Optional login copy and limits (seconds)
ALBUM_LOGIN_TITLE=来照片星球坐坐。
ALBUM_LOGIN_NOTE=那些小小的开心，都收在这里。
ALBUM_MAX_FAILURES=5
ALBUM_FAILURE_WINDOW=900
ALBUM_LOCK_SECONDS=900
